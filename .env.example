# ============================================================
# TELEGRAM BOT SETTINGS
# ============================================================
# Токен бота, отриманий у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# ID вашого чату (або декілька через кому), куди надсилати екстрені сповіщення про вимкнення світла
# Можна дізнатися свій ID через бота @userinfobot
TELEGRAM_ADMIN_CHAT_IDS=123456789

# ============================================================
# WEB DASHBOARD & URL
# ============================================================
# Публічна адреса вашого сайту (на Render це буде https://ваш-додаток.onrender.com)
WEB_BASE_URL=https://your-app.onrender.com
PORT=8000
HOST=0.0.0.0

# Секретний токен для відправки телеметрії (якщо використовується локальний push-скрипт)
SECRET_PUSH_TOKEN=deye-super-secret-key-12345

# ============================================================
# SOLARMAN CLOUD / DEYE OPEN API
# ============================================================
# Чи підключатися до хмари Solarman
SOLARMAN_ENABLED=true

# Реєстрація на https://developer.solarmanpv.com (безкоштовно)
SOLARMAN_APP_ID=your_solarman_app_id
SOLARMAN_APP_SECRET=your_solarman_app_secret

# Ваш логін (email) та пароль від додатку Solarman Smart / Deye Cloud
SOLARMAN_EMAIL=your_email@example.com
SOLARMAN_PASSWORD=your_solarman_password

# Серійний номер інвертора (наприклад: 2406129841)
SOLARMAN_INVERTER_SN=your_inverter_serial_number

# URL API (за замовчуванням глобальний сервер Solarman)
SOLARMAN_API_URL=https://globalapi.solarmanpv.com

# Інтервал опитування хмари в секундах (рекомендовано 15-30)
POLL_INTERVAL_SECONDS=15
