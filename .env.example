# ============================================================
# TELEGRAM BOT SETTINGS
# ============================================================
# Токен бота, отриманий у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# ID вашого чату (або декілька через кому), куди надсилати екстрені сповіщення про вимкнення світла
# Можна дізнатися свій ID через бота @userinfobot
TELEGRAM_ADMIN_CHAT_IDS=123456789

# ============================================================
# WEB DASHBOARD & URL
# ============================================================
# Публічна адреса вашого сайту (на Render це буде https://ваш-додаток.onrender.com)
WEB_BASE_URL=https://your-app.onrender.com
PORT=8000
HOST=0.0.0.0

# Секретний токен для відправки телеметрії (якщо використовується локальний push-скрипт)
SECRET_PUSH_TOKEN=deye-super-secret-key-12345

# ============================================================
# DEYE CLOUD OPEN API (Офіційний Deye Cloud)
# https://developer.deyecloud.com
# ============================================================
DEYE_ENABLED=true

# Отримуються безкоштовно на https://developer.deyecloud.com
DEYE_APP_ID=your_deye_app_id
DEYE_APP_SECRET=your_deye_app_secret

# Логін (email) та пароль від додатку Deye Cloud на телефоні
DEYE_EMAIL=your_email@example.com
DEYE_PASSWORD=your_deye_password

# Серійний номер інвертора Deye (наприклад: 2406129841)
DEYE_DEVICE_SN=your_inverter_serial_number

# Інтервал опитування в секундах (рекомендовано 15-30)
POLL_INTERVAL_SECONDS=15

# ============================================================
# АЛЬТЕРНАТИВНО: SOLARMAN CLOUD API (якщо акаунт у Solarman)
# ============================================================
SOLARMAN_ENABLED=false
SOLARMAN_APP_ID=
SOLARMAN_APP_SECRET=
SOLARMAN_EMAIL=
SOLARMAN_PASSWORD=
SOLARMAN_INVERTER_SN=
SOLARMAN_API_URL=https://globalapi.solarmanpv.com
